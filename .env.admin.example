# Private database settings from the authorized backend owner.
# Copy this to .env.admin, fill it locally, and never commit the private file.
# These settings are used by the CLI only, not the browser or frontend server.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional official database CA certificate, with newlines escaped as \n.
# Certificate verification is always enabled by the setup script.
DB_SSL_CA=
